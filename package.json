{
  "name": "dwst",
  "license": "CC0-1.0",
  "browserslist": [
    "last 1 chrome versions",
    "last 1 firefox versions",
    "last 1 safari versions",
    "last 1 edge versions"
  ],
  "scripts": {
    "build": "yarn gulp build",
    "build:release": "yarn gulp buildRelease",
    "format": "prettier --write \"**/*.{js,mjs,css,json}\"",
    "lint": "yarn lint:js && yarn lint:css && yarn lint:html && yarn lint:knip && yarn lint:format",
    "lint:css": "stylelint \"dwst/styles/*.css\"",
    "lint:format": "prettier --check \"**/*.{js,mjs,css,json}\"",
    "lint:html": "htmlhint --config .htmlhintrc dwst/dwst.html",
    "lint:js": "eslint .",
    "lint:knip": "knip",
    "test": "mocha --require @babel/register test/test.js"
  },
  "engines": {
    "node": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.0.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^1.2.0",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "chai": "^4.2.0",
    "core-js": "^3.0.0-beta.8",
    "eslint": "^9.39.4",
    "eslint-plugin-chai-friendly": "^1.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "fs-extra": "^11.2.0",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^1.2.2",
    "gulp-replace": "^1.0.0",
    "htmlhint": "^1.9.2",
    "knip": "^6.14.1",
    "mocha": "^10.8.2",
    "postcss": "^8.5.25",
    "postcss-color-hex-alpha": "^11.0.0",
    "postcss-discard-comments": "^8.0.0",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "rewire": "^9.0.1",
    "simple-git": "^4.0.0",
    "stylelint": "^17.12.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "webpack": "^5.107.2"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.5"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
